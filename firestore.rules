rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // Profiles: every signed-in user can read (needed for "add member by email"),
    // only the owner can write their own profile, nobody deletes.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow delete: if false;

      match /expenses/{expenseId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.amountOre is int
          && request.resource.data.amountOre > 0;
        allow delete: if isMember(groupId) && resource.data.createdBy == request.auth.uid;
        allow update: if false;   // expenses are never edited
      }

      match /reminders/{reminderId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId) && request.resource.data.fromUserId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // "All reminders addressed to me" across groups (collection group query, stage 8)
    match /{path=**}/reminders/{reminderId} {
      allow read: if signedIn() && resource.data.toUserId == request.auth.uid;
    }
  }
}

