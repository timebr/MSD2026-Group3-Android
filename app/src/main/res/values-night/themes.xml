<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Night twin of values/themes.xml: dark launch background and light system
         bar icons, so the first frame matches the Compose dark color scheme. -->
    <style name="Theme.OweOwe" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
